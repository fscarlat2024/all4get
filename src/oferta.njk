---
layout: landing.njk
title: Jucării care îți fac pisica fericită
description: Jucărie laser rotativă 360 pentru pisici. Plată ramburs la livrare, livrare 24-48h, retur în 14 zile.
permalink: /oferta/
---
{% set laser = null %}
{% set minge = null %}
{% for p in collections.products %}
  {% if p.data.sku == 'PET-CAT-002' %}{% set laser = p %}{% endif %}
  {% if p.data.sku == 'PET-CAT-001' %}{% set minge = p %}{% endif %}
{% endfor %}

<section class="lp-hero wrap">
  <p class="eyebrow">Pentru pisica ta 🐾</p>
  <h1>Fă-i pisicii cea mai bună zi</h1>
  <p class="lede">Jucărie interactivă testată — se joacă singură și când tu nu ești acasă. Plătești la livrare, retur în 14 zile.</p>
</section>

<section class="wrap lp-main">
  <div class="product-grid">
    <div class="product-media" data-gallery>
      <img class="main-img" src="{{ laser.data.image }}" alt="{{ laser.data.name }}" loading="eager">
      {% if laser.data.gallery %}
      <div class="thumbs">
        <img class="thumb is-active" src="{{ laser.data.image }}" alt="{{ laser.data.name }}" width="160" height="160" loading="lazy">
        {% for g in laser.data.gallery %}<img class="thumb" src="{{ g }}" alt="{{ laser.data.name }}" width="160" height="160" loading="lazy">{% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="product-info">
      <p class="eyebrow">{{ laser.data.category }}</p>
      <h2>{{ laser.data.name }}</h2>
      <p class="lede">{{ laser.data.short }}</p>
      <div class="price-row">
        <span class="price">{{ laser.data.price | lei }}</span>
        {% if laser.data.oldPrice %}<span class="price-old">{{ laser.data.oldPrice | lei }}</span>{% endif %}
      </div>
      <p class="stock {% if laser.data.stock > 0 %}in{% else %}out{% endif %}">{% if laser.data.stock > 0 %}✔ În stoc ({{ laser.data.stock }} buc.){% else %}✖ Stoc epuizat{% endif %}</p>

      <div class="guarantee">
        <span class="g-ic">🛡️</span>
        <div class="g-body">
          <strong>Comanzi fără nicio grijă</strong>
          <p>Plătești <strong>cash la curier</strong>, când primești coletul — fără plată online, fără cont. Nu-ți place? <strong>Retur gratuit în 14 zile.</strong></p>
        </div>
      </div>

      <!-- ===== FORMULAR COMANDA ===== -->
      <form id="order-form" class="order-form"
        data-endpoint="https://all4get-webhook.fscarlat.workers.dev/order"
        data-main-sku="{{ laser.data.sku }}" data-main-unit="{{ laser.data.price }}" data-main-bundle="{{ laser.data.bundle2Price }}"
        {% if minge %}data-upsell-sku="{{ minge.data.sku }}" data-upsell-unit="{{ minge.data.price }}"{% endif %}
        data-free-ship="300" data-flat-ship="19.99">

        <h3 class="of-title">Comandă acum</h3>

        <div class="of-field">
          <label class="of-label">Cantitate</label>
          <div class="of-qty">
            <label class="qty-opt"><input type="radio" name="qty" value="1" checked> <span>1 bucată — <strong>{{ laser.data.price | lei }}</strong></span></label>
            {% if laser.data.bundle2Price %}
            <label class="qty-opt qty-deal"><input type="radio" name="qty" value="2"> <span>2 bucăți — <strong>{{ laser.data.bundle2Price | lei }}</strong> <em>economisești {{ laser.data.bundle2Save }} lei 🎁</em></span></label>
            {% endif %}
          </div>
        </div>

        {% if laser.data.colors %}
        <div class="of-field">
          <label class="of-label" for="laser-color">Culoare</label>
          <select id="laser-color" name="mainColor" class="of-select">{% for c in laser.data.colors %}<option value="{{ c }}">{{ c }}</option>{% endfor %}</select>
        </div>
        {% endif %}

        {% if minge %}
        <div class="of-upsell">
          <label class="of-upsell-head">
            <input type="checkbox" id="add-upsell" name="addUpsell">
            <img src="{{ minge.data.image }}" alt="{{ minge.data.name }}" width="54" height="54">
            <span class="of-upsell-txt">➕ Adaugă și <strong>{{ minge.data.name }}</strong><br><em>încă {{ minge.data.price | lei }} — aceleași condiții</em></span>
          </label>
          {% if minge.data.colors %}
          <div class="of-upsell-color" id="upsell-color-wrap" hidden>
            <label class="of-label" for="upsell-color">Culoare minge</label>
            <select id="upsell-color" name="upsellColor" class="of-select">{% for c in minge.data.colors %}<option value="{{ c }}">{{ c }}</option>{% endfor %}</select>
          </div>
          {% endif %}
        </div>
        {% endif %}

        <div class="of-sep"><span>Date de livrare</span></div>

        <div class="of-field"><input class="of-input" type="text" name="nume" placeholder="Nume și prenume *" autocomplete="name" required></div>
        <div class="of-field"><input class="of-input" type="tel" name="telefon" placeholder="Telefon *" autocomplete="tel" required></div>
        <div class="of-row2">
          <input class="of-input" type="text" name="oras" placeholder="Oraș / Localitate *" autocomplete="address-level2" required>
          <input class="of-input" type="text" name="judet" placeholder="Județ" autocomplete="address-level1">
        </div>
        <div class="of-field"><input class="of-input" type="text" name="adresa" placeholder="Adresa completă (stradă, nr., bloc, ap.) *" autocomplete="street-address" required></div>
        <div class="of-field"><input class="of-input" type="email" name="email" placeholder="Email (opțional, pentru confirmare)" autocomplete="email"></div>

        <!-- honeypot anti-bot -->
        <input type="text" name="website" class="of-hp" tabindex="-1" autocomplete="off" aria-hidden="true">

        <div class="of-field">
          <label class="of-label">Modalitate de plată</label>
          <label class="pay-opt pay-active"><input type="radio" name="plata" value="ramburs" checked> <span>💵 <strong>Ramburs</strong> — plătești cash la curier când primești coletul</span></label>
          <label class="pay-opt pay-soon"><input type="radio" name="plata" value="card" disabled> <span>💳 Card online <em>— disponibil în curând</em></span></label>
        </div>

        <div class="of-summary">
          <div class="of-sumline"><span>Produse</span><span id="sum-sub">—</span></div>
          <div class="of-sumline"><span>Transport</span><span id="sum-ship">—</span></div>
          <div class="of-sumline of-total"><span>Total</span><span id="sum-total">—</span></div>
        </div>

        <button type="submit" class="btn btn-buy of-submit" {% if laser.data.stock <= 0 %}disabled{% endif %}>Trimite comanda</button>
        <p class="of-note">Te sunăm pentru confirmare înainte de expediere. Transport gratuit peste 300 lei.</p>
        <p class="of-error" id="of-error" hidden></p>
      </form>

      <ul class="perks">
        <li>Livrare {{ site.shipping.deliveryTime }}</li>
        <li>Retur gratuit în 14 zile</li>
        <li>Plată ramburs la livrare</li>
      </ul>
    </div>
  </div>
</section>

<!-- Multumesc (ascuns pana la comanda) -->
<section class="wrap of-thanks" id="of-thanks" hidden>
  <div class="of-thanks-card">
    <div class="of-thanks-ic">🎉</div>
    <h2>Mulțumim! Comanda ta a fost înregistrată.</h2>
    <p>Te sunăm în scurt timp la numărul lăsat, ca să confirmăm comanda înainte de expediere. Plătești cash la curier când primești coletul. 🐾</p>
    <p class="of-thanks-id" id="of-thanks-id"></p>
  </div>
</section>

<script src="/assets/js/order.js" defer></script>
