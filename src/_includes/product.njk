---
layout: base.njk
---
<article class="wrap product-page">
  <nav class="crumbs" aria-label="Cale">
    <a href="/">Acasa</a> ›
    <a href="/magazin/">Magazin</a> ›
    <a href="/categorie/{{ product.category | slug }}/">{{ product.category }}</a> ›
    <span>{{ product.name }}</span>
  </nav>

  <div class="product-grid">
    <div class="product-media" data-gallery>
      {% if product.image %}
      <img class="main-img" src="{{ product.image }}" alt="{{ product.name }}" loading="eager">
      {% else %}
      <div class="ph-img" aria-hidden="true">Fara imagine</div>
      {% endif %}
      {% if product.gallery %}
      <div class="thumbs">
        <img class="thumb is-active" src="{{ product.image }}" alt="{{ product.name }}" width="160" height="160" loading="lazy">
        {% for g in product.gallery %}
        <img class="thumb" src="{{ g }}" alt="{{ product.name }}" width="160" height="160" loading="lazy">
        {% endfor %}
      </div>
      {% endif %}
    </div>

    <div class="product-info">
      <p class="eyebrow">{{ product.category }}</p>
      <h1>{{ product.name }}</h1>
      <p class="lede">{{ product.short }}</p>

      <div class="price-row">
        <span class="price">{{ product.price | lei }}</span>
        {% if product.oldPrice %}<span class="price-old">{{ product.oldPrice | lei }}</span>{% endif %}
      </div>

      <p class="stock {% if product.stock > 0 %}in{% else %}out{% endif %}">
        {% if product.stock > 0 %}✔ In stoc ({{ product.stock }} buc.){% else %}✖ Stoc epuizat{% endif %}
      </p>

      {% if product.colors %}
      <div class="opt-row">
        <label class="opt-label" for="color-picker">Alege culoarea</label>
        <select id="color-picker" class="opt-select">
          {% for c in product.colors %}<option value="{{ c }}">{{ c }}</option>{% endfor %}
        </select>
      </div>
      {% endif %}

      {% if product.bundle2Price and product.stock > 1 %}
      <div class="bundle-offer">
        <span class="bundle-badge">🎁 Ofertă</span>
        <span class="bundle-text">Ia <strong>2 bucăți</strong> și plătești doar <strong>{{ product.bundle2Price | lei }}</strong> — economisești <strong>{{ product.bundle2Save }} lei</strong>. Perfect și ca al doilea cadou 🐾</span>
      </div>
      {% endif %}

      <div class="buy-actions">
        <button
          class="btn btn-buy snipcart-add-item"
          {% if product.stock <= 0 %}disabled{% endif %}
          data-item-id="{{ product.sku }}"
          data-item-price="{{ product.price }}"
          data-item-url="{{ page.url }}"
          data-item-name="{{ product.name }}"
          data-item-description="{{ product.short }}"
          data-item-image="{{ product.image }}"
          data-item-max-quantity="{{ product.stock }}"
          data-item-categories="{{ product.category }}"
          {% if product.colors %}data-item-custom1-name="Culoare" data-item-custom1-options="{{ product.colors | join('|') }}" data-item-custom1-value="{{ product.colors[0] }}"{% endif %}>
          Adauga in cos
        </button>

        {% if product.bundle2Price and product.stock > 1 %}
        <button
          class="btn btn-bundle snipcart-add-item"
          data-item-id="{{ product.sku }}"
          data-item-price="{{ product.price }}"
          data-item-url="{{ page.url }}"
          data-item-name="{{ product.name }}"
          data-item-description="{{ product.short }}"
          data-item-image="{{ product.image }}"
          data-item-max-quantity="{{ product.stock }}"
          data-item-quantity="2"
          data-item-categories="{{ product.category }}"
          {% if product.colors %}data-item-custom1-name="Culoare" data-item-custom1-options="{{ product.colors | join('|') }}" data-item-custom1-value="{{ product.colors[0] }}"{% endif %}>
          Adaugă 2 — {{ product.bundle2Price | lei }}
        </button>
        {% endif %}
      </div>

      {% if product.colors %}
      <script>
      (function(){
        var sel=document.getElementById('color-picker');
        var btns=document.querySelectorAll('.product-info .snipcart-add-item');
        if(sel&&btns.length){sel.addEventListener('change',function(){btns.forEach(function(b){b.setAttribute('data-item-custom1-value',sel.value);});});}
      })();
      </script>
      {% endif %}

      <div class="guarantee">
        <span class="g-ic">🛡️</span>
        <div class="g-body">
          <strong>Comanzi fără nicio grijă</strong>
          <p>Plătești <strong>cash la curier</strong>, când primești coletul — fără plată online, fără cont. Nu-ți place? <strong>Retur gratuit în 14 zile.</strong></p>
        </div>
      </div>

      <ul class="perks">
        <li>Livrare {{ site.shipping.deliveryTime }}</li>
        <li>Retur gratuit in 14 zile</li>
        <li>Transport gratuit peste {{ site.shipping.freeThreshold | lei }}</li>
      </ul>
    </div>
  </div>

  <section class="product-desc">
    <h2>Descriere</h2>
    {{ content | safe }}

    {% if product.specs %}
    <h2>Specificatii</h2>
    <table class="specs">
      {% for row in product.specs %}
      <tr><th>{{ row.k }}</th><td>{{ row.v }}</td></tr>
      {% endfor %}
    </table>
    {% endif %}
  </section>

  {% set hasOther = false %}
  {% for p in collections.products %}{% if p.data.sku != product.sku %}{% set hasOther = true %}{% endif %}{% endfor %}
  {% if hasOther %}
  <section class="wrap bought-together">
    <div class="section-head center">
      <h2>Se cumpără des împreună</h2>
      <p class="muted">Completează cadoul — pisica ta merită amândouă 🐾</p>
    </div>
    <div class="product-cards">
      {% for p in collections.products %}{% if p.data.sku != product.sku %}
      {% include "card.njk" %}
      {% endif %}{% endfor %}
    </div>
  </section>
  {% endif %}

  <div class="xsell-pop" id="xsellPop" hidden aria-hidden="true" data-current-sku="{{ product.sku }}">
    <div class="xsell-card" role="dialog" aria-label="Recomandare">
      <button class="xsell-close" type="button" aria-label="Închide">×</button>
      <p class="xsell-head">🐾 Adăugat în coș! Îți mai trebuie?</p>
      {% for p in collections.products %}{% if p.data.sku != product.sku %}
      <div class="xsell-item">
        <img src="{{ p.data.image }}" alt="{{ p.data.name }}" width="64" height="64" loading="lazy">
        <div class="xsell-meta">
          <span class="xsell-name">{{ p.data.name }}</span>
          <span class="xsell-price">{{ p.data.price | lei }}</span>
        </div>
        <button
          class="btn btn-xsell snipcart-add-item"
          data-item-id="{{ p.data.sku }}"
          data-item-price="{{ p.data.price }}"
          data-item-url="{{ p.url }}"
          data-item-name="{{ p.data.name }}"
          data-item-description="{{ p.data.short }}"
          data-item-image="{{ p.data.image }}"
          data-item-max-quantity="{{ p.data.stock }}"
          data-item-categories="{{ p.data.category }}"
          {% if p.data.colors %}data-item-custom1-name="Culoare" data-item-custom1-options="{{ p.data.colors | join('|') }}" data-item-custom1-value="{{ p.data.colors[0] }}"{% endif %}>
          Adaugă
        </button>
      </div>
      {% endif %}{% endfor %}
    </div>
  </div>
</article>
